FROM apache/airflow:2.10.5-python3.11

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends default-jre-headless \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/default-java

USER airflow
COPY backend/requirements.txt requirements-ml.txt /tmp/
RUN pip install --no-cache-dir --default-timeout=1000 --retries 10 -r /tmp/requirements.txt -r /tmp/requirements-ml.txt
ENV PYTHONPATH=/opt/ekover
